        "import numpy as np\n",
        "import re\n",
        "\n",
        "notes_text = \"\"\"\n",
        "Machine learning is a subset of artificial intelligence that enables systems to learn from data.\n",
        "Supervised learning uses labeled data to train models and make predictions.\n",
        "Unsupervised learning finds hidden patterns in data without labeled outputs.\n",
        "Deep learning uses neural networks with multiple layers to process complex data.\n",
        "Natural language processing helps computers understand and generate human language.\n",
        "A neural network is inspired by the structure of the human brain.\n",
        "Data preprocessing is an important step before training any machine learning model.\n",
        "Overfitting happens when a model learns the training data too well but fails on new data.\n",
        "\"\"\"\n",
        "\n",
        "sentences = [s.strip() for s in re.split(r'[.\\n]', notes_text) if len(s.strip()) > 10]\n",
        "print(f\"Total sentences: {len(sentences)}\")\n",
        "print(sentences)"
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "def build_vocabulary(sentences):\n",
        "    vocab = set()\n",
        "    for s in sentences:\n",
        "        words = re.findall(r'\\b[a-z]+\\b', s.lower())\n",
        "        vocab.update(words)\n",
        "    return sorted(list(vocab))\n",
        "\n",
        "vocab = build_vocabulary(sentences)\n",
        "word_index = {word: i for i, word in enumerate(vocab)}\n",
        "print(f\"Vocabulary size: {len(vocab)}\")\n",
        "print(vocab)"
