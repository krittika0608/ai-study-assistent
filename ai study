        "def sentence_to_vector(sentence, word_index):\n",
        "    vec = np.zeros(len(word_index))\n",
        "    words = re.findall(r'\\b[a-z]+\\b', sentence.lower())\n",
        "    for w in words:\n",
        "        if w in word_index:\n",
        "            vec[word_index[w]] += 1\n",
        "    return vec\n",
        "\n",
        "sentence_vectors = np.array([sentence_to_vector(s, word_index) for s in sentences])\n",
        "print(\"Sentence vector matrix shape:\", sentence_vectors.shape)"
      ],
