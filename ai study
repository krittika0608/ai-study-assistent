    {
      "cell_type": "code",
      "source": [
        "def find_most_relevant_sentence(question, sentences, sentence_vectors, word_index):\n",
        "    question_vec = sentence_to_vector(question, word_index)\n",
        "    similarities = np.array([\n",
        "        cosine_similarity_manual(question_vec, sentence_vectors[i])\n",
        "        for i in range(len(sentences))\n",
        "    ])\n",
        "    best_idx = np.argmax(similarities)\n",
        "    return sentences[best_idx], similarities[best_idx]\n",
        "\n",
        "question = \"what is deep learning\"\n",
        "answer, score = find_most_relevant_sentence(question, sentences, sentence_vectors, word_index)\n",
        "\n",
        "print(f\"Question: {question}\")\n",
        "print(f\"Answer: {answer}\")\n",
        "print(f\"Confidence score: {score:.3f}\")"
